# Docker 구성(docker-compose.yml)이 읽는 환경 파일의 예시. 이 파일을 .env로 복사해 값을 채운다.
# .env는 .gitignore 대상이라 저장소에 올라가지 않는다.

# LiteLLM 프록시에 붙을 때 쓰는 키. 파이프라인은 LITELLM_API_KEY로 같은 값을 받는다.
# 프록시가 LAN에 열리므로 남이 짐작하지 못할 값으로 정한다. 비워 두면 docker compose가 시작하지 않는다.
LITELLM_MASTER_KEY=

# Groq API 키(무료 등급). 비워 두면 LLM·VLM 호출이 실패한다(예비 모델 없음, ADR-0015).
GROQ_API_KEY=

# 사례 저장소 임베딩 모델의 OpenAI 호환 주소. 비우면 같은 구성의 ollama(http://ollama:11434/v1)를 쓴다.
# 다른 머신의 Ollama·LM Studio·llama.cpp를 쓰려면 그 주소로 바꾼다(예: http://192.168.0.20:11434/v1).
EMBEDDING_MODEL_URL=
