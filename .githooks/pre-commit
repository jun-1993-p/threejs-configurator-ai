#!/bin/sh
# 커밋 전 검사. 스테이지된 파일에 따라 TS(구성기·파이프라인)와 Python(애드인·서버·합성 녹화본·LiteLLM 설정·도구) 검사를 돌린다.
# 켜기: git config core.hooksPath .githooks
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
if [ -x .venv/Scripts/python ]; then py=.venv/Scripts/python; else py=.venv/bin/python; fi
if [ ! -x "$py" ]; then
  echo "[pre-commit] .venv가 없다. 모든 커밋이 비공개 이름 검사에 .venv를 쓴다. docs/recording-guide.md 4-1대로 설치한다"
  exit 1
fi

# 저장소는 공개다. 비공개 녹화본·탐색 결과의 상품 이름이 추적 파일로 새지 않게 모든 커밋에서 본다
PYTHONUTF8=1 "$py" -m scripts.private_names

# 셸 스크립트의 여러 줄 python -c는 따옴표가 깨져도 bash -n을 통과하고 mypy·시험도 거치지 않는다(티켓 26 회고).
# 그런 코드는 scripts/ 모듈로 옮기고 위저드는 python -m으로 부른다.
# 인터프리터 이름은 보지 않는다("$py" -c, python3 -c 모두). 줄 끝의 -c ' 나 -c " 가 여러 줄 인라인 코드의 시작이다.
if grep -nE -- "-c ['\"]\s*$" scripts/*.sh .githooks/pre-commit; then
  echo "[pre-commit] 위 여러 줄 -c 코드를 scripts/ 모듈로 옮긴다(.venv/Scripts/python -m scripts.<모듈>)"
  exit 1
fi
if echo "$staged" | grep -qE '(\.sh$|^\.githooks/|^\.shellcheckrc$)'; then
  echo "[pre-commit] shellcheck: 셸 스크립트(끈 경고와 까닭은 .shellcheckrc와 그 줄 위의 주석)"
  if [ -x .venv/Scripts/shellcheck ]; then sc=.venv/Scripts/shellcheck; else sc=.venv/bin/shellcheck; fi
  if [ ! -x "$sc" ]; then
    echo "[pre-commit] shellcheck가 없다. .venv에 dev 의존성을 다시 설치한다: \"$py\" -m pip install -e \".[dev]\""
    exit 1
  fi
  "$sc" -f gcc scripts/*.sh .githooks/pre-commit
fi

# 시험 이름은 GLOSSARY 용어(한국어)로 쓴다(CODING_STANDARDS.md 「주석과 이름」). 한글이 하나도 없는 이름을 찾는다.
# shellcheck disable=SC2016  # 작은따옴표 안의 $·`는 일부러 펼치지 않는다(메모의 마크다운 코드, node 코드, 정규식)
if grep -rnE '^def test_[A-Za-z0-9_]+\(' addin/tests server/tests synthetic/tests docker/tests scripts/tests \
  || grep -rnE '^\s*test\(["`][^가-힣"`]*["`]' configurator/test; then
  echo "[pre-commit] 위 시험 이름을 GLOSSARY 용어(한국어)로 고친다"
  exit 1
fi

# schema/는 서버와 파이프라인이 같이 읽으므로 양쪽을 다 돌린다
if echo "$staged" | grep -qE '^(configurator/|schema/|fixtures/)'; then
  echo "[pre-commit] configurator: 타입 검사와 테스트"
  # 통과하면 점만, 실패하면 그 시험의 내용만 찍는다
  (cd configurator && npm run --silent typecheck && npm test --silent -- --test-reporter=dot)
fi

if echo "$staged" | grep -qE '^(addin/|server/|synthetic/|docker/|scripts/|schema/|fixtures/|pyproject\.toml)'; then
  echo "[pre-commit] Python: mypy와 pytest(solidcraft-cli로 다시 녹화하는 시험 포함)"
  "$py" -m mypy
  "$py" -m pytest -q
fi
