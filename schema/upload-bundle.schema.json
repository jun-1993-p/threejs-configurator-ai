{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upload-bundle.schema.json",
  "title": "업로드 묶음",
  "description": "CAD 애드인이 서버로 보내는 모델의 파라미터·부품·스윕. 길이 단위는 mm.",
  "type": "object",
  "required": ["schema_version", "units", "grid", "parameters", "parts", "baseline", "sweeps"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "units": { "const": "mm" },
    "source": {
      "description": "묶음을 만든 도구. solidcraft는 합성 녹화본이다.",
      "enum": ["fusion", "solidcraft"]
    },
    "grid": {
      "description": "경계 맞춤 격자의 밀도 기준(ADR-0016). 점 간격은 바디 바운딩 박스 대각선 / (2(n-1)).",
      "type": "object",
      "required": ["n"],
      "additionalProperties": false,
      "properties": { "n": { "type": "integer", "minimum": 2 } }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "unit", "expression", "is_user", "is_count"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "expression": { "type": "string" },
          "is_user": { "type": "boolean" },
          "is_count": {
            "description": "개수형 파라미터(단위가 없는 정수, 자식 포함). 스윕하지 않고 슬라이더 후보가 될 수 없다(ADR-0005).",
            "type": "boolean"
          }
        }
      }
    },
    "parts": {
      "description": "부품. Fusion 컴포넌트 단위, 컴포넌트가 없는 바디는 바디 단위(ADR-0006). faces는 기본 형상 면 목록의 위치.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "faces"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["component", "body"] },
          "faces": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": ["faces", "edges"],
      "additionalProperties": false,
      "properties": {
        "faces": {
          "description": "기본 형상의 면. 연결 정보(triangles)는 여기에만 있고 모든 샘플이 같이 쓴다.",
          "type": "array",
          "items": { "allOf": [{ "$ref": "#/$defs/face" }, { "required": ["triangles"] }] }
        },
        "edges": { "$ref": "#/$defs/edges" },
        "bodies": { "$ref": "#/$defs/bodies" }
      }
    },
    "sweeps": {
      "description": "사용자 파라미터마다 하나씩인 단독 스윕.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["parameter", "range", "samples", "checks"],
        "additionalProperties": false,
        "properties": {
          "parameter": { "type": "string", "minLength": 1 },
          "range": {
            "description": "스윕 범위. 기본값 ±50%에서 reductions만큼 줄어든 범위이고, samples와 checks는 이 안에 있다.",
            "type": "object",
            "required": ["min", "max"],
            "additionalProperties": false,
            "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
          },
          "samples": { "type": "array", "items": { "$ref": "#/$defs/sample" } },
          "checks": {
            "description": "검증점: 이웃 샘플 사이 가운데 값의 형상. 변형 결과와 비교하는 데만 쓰고 섞지 않는다(ADR-0012).",
            "type": "array",
            "items": { "$ref": "#/$defs/sample" }
          },
          "reductions": {
            "description": "범위 끝 쪽에서 면 구성(면과 모서리)이 바뀌어 범위를 줄인 기록(ADR-0005). 쪽마다 하나까지다.",
            "type": "array",
            "maxItems": 2,
            "items": { "$ref": "#/$defs/reduction" }
          }
        }
      }
    }
  },
  "$defs": {
    "reduction": {
      "type": "object",
      "required": ["side", "at", "reason", "removed_faces", "added_faces", "removed_edges", "added_edges", "counts"],
      "additionalProperties": false,
      "properties": {
        "side": { "description": "줄어든 쪽", "enum": ["min", "max"] },
        "at": { "description": "기본값에서 그쪽으로 가며 면 구성이 처음 바뀐 값(샘플 또는 검증점)", "type": "number" },
        "reason": {
          "description": "검증 피드백 종류와 같다. range_shrunk: 개수형 파라미터 값도 바뀌었다. modeling_error_suspected: 개수형 값은 그대로인데 면 구성이 바뀌었다.",
          "enum": ["range_shrunk", "modeling_error_suspected"]
        },
        "removed_faces": { "$ref": "#/$defs/faceRefs" },
        "added_faces": { "$ref": "#/$defs/faceRefs" },
        "removed_edges": { "$ref": "#/$defs/faceRefs" },
        "added_edges": { "$ref": "#/$defs/faceRefs" },
        "counts": {
          "description": "그 지점에서 값이 바뀐 개수형 파라미터: [기본값, 그 지점 값]",
          "type": "object",
          "additionalProperties": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
        }
      }
    },
    "faceRefs": {
      "description": "기본 형상과 비교해 사라지거나 생긴 면(또는 모서리)의 바디와 이름",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["body", "name"],
        "additionalProperties": false,
        "properties": { "body": { "type": "string" }, "name": { "type": "string" } }
      }
    },
    "sampleResponse": {
      "description": "추가 샘플 요청에 대한 애드인 응답(ADR-0013). samples는 요청의 값 묶음과 같은 순서다.",
      "type": "object",
      "required": ["samples"],
      "additionalProperties": false,
      "properties": {
        "samples": { "type": "array", "items": { "$ref": "#/$defs/crossSample" } }
      }
    },
    "crossSample": {
      "description": "여러 파라미터를 함께 바꾼 형상. 단독 스윕 샘플과 같고 value 대신 values를 쓴다.",
      "type": "object",
      "required": ["values", "status", "faces", "edges"],
      "additionalProperties": false,
      "properties": {
        "values": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "number" } },
        "status": { "enum": ["ok", "recompute_failed"] },
        "faces": { "$ref": "#/$defs/faces" },
        "edges": { "$ref": "#/$defs/edges" },
        "bodies": { "$ref": "#/$defs/bodies" }
      }
    },
    "sample": {
      "type": "object",
      "required": ["value", "status", "faces", "edges"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "status": { "enum": ["ok", "recompute_failed"] },
        "faces": { "$ref": "#/$defs/faces" },
        "edges": { "$ref": "#/$defs/edges" },
        "bodies": { "$ref": "#/$defs/bodies" },
        "counts": {
          "description": "모델에 개수형 파라미터가 있으면 이 샘플에서의 그 값",
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "faces": { "type": "array", "items": { "$ref": "#/$defs/face" } },
    "face": {
      "type": "object",
      "required": ["body", "surface", "name", "points"],
      "additionalProperties": false,
      "if": { "properties": { "surface": { "enum": ["plane", "cylinder"] } } },
      "then": {
        "description": "평면·원기둥은 표면 정의가 있어야 한다. 면 짝짓기 확인과 판재 두께 측정(수치 검증)에 쓴다.",
        "required": ["geometry"]
      },
      "properties": {
        "body": { "type": "string", "minLength": 1 },
        "surface": { "type": "string" },
        "name": {
          "description": "피처 기준 면 이름(ADR-0016). 샘플 사이에서 면을 짝짓는다.",
          "type": "string",
          "minLength": 1
        },
        "geometry": {
          "description": "면의 표면. 평면은 법선, 원기둥은 원점·축·반지름.",
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "normal"],
              "additionalProperties": false,
              "properties": {
                "type": { "const": "plane" },
                "normal": { "$ref": "#/$defs/vector" }
              }
            },
            {
              "type": "object",
              "required": ["type", "origin", "axis", "radius"],
              "additionalProperties": false,
              "properties": {
                "type": { "const": "cylinder" },
                "origin": { "$ref": "#/$defs/vector" },
                "axis": { "$ref": "#/$defs/vector" },
                "radius": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          ]
        },
        "points": { "type": "array", "items": { "$ref": "#/$defs/vector" } },
        "triangles": {
          "description": "면의 연결. points 번호 세 개씩. 기본 형상에서 한 번 정한다(ADR-0016).",
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    "edges": {
      "description": "모서리. 이름은 두 면 이름 쌍 `면A|면B`이고, 같은 쌍이 여럿이면 `~순번`이 붙는다. 곡선 모서리는 mid로 모양을 안다.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["body", "name", "start", "mid", "end"],
        "additionalProperties": false,
        "properties": {
          "body": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "start": { "$ref": "#/$defs/vector" },
          "mid": { "$ref": "#/$defs/vector" },
          "end": { "$ref": "#/$defs/vector" }
        }
      }
    },
    "bodies": {
      "description": "바디별 측정값. 위상 비교와 부피 튐 검사에 쓴다.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "volume", "bbox"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "volume": { "type": "number" },
          "bbox": {
            "type": "object",
            "required": ["min", "max"],
            "additionalProperties": false,
            "properties": {
              "min": { "$ref": "#/$defs/vector" },
              "max": { "$ref": "#/$defs/vector" }
            }
          }
        }
      }
    },
    "vector": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
